# ===========================================
# MedicusUnion KZ - Directus Backend Config
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Database ---
DB_USER=directus
DB_PASSWORD=change-me-strong-password
DB_DATABASE=directus

# --- Directus ---
DIRECTUS_PORT=8055
DIRECTUS_SECRET=generate-a-random-64-char-string
DIRECTUS_ADMIN_EMAIL=admin@medicusunion.kz
DIRECTUS_ADMIN_PASSWORD=change-me-strong-password

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,https://medicusunion.kz,https://www.medicusunion.kz

# --- Public URL ---
PUBLIC_URL=http://localhost:8055
