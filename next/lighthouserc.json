{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start --port 3101",
      "startServerReadyPattern": "Ready in",
      "url": [
        "http://localhost:3101/",
        "http://localhost:3101/checkup",
        "http://localhost:3101/consultations",
        "http://localhost:3101/treatment-abroad",
        "http://localhost:3101/contacts"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 360,
          "height": 640,
          "deviceScaleFactor": 2,
          "disabled": false
        },
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "cpuSlowdownMultiplier": 4,
          "requestLatencyMs": 0,
          "downloadThroughputKbps": 0,
          "uploadThroughputKbps": 0
        }
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "interactive": ["warn", { "maxNumericValue": 3500 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "../.planning/phases/95-audit-and-verification/lighthouse"
    }
  }
}
