# Local development (outside Docker)
DATABASE_URL=postgresql://medicus:medicus-local-dev@localhost:5432/medicus

# Admin route gate (Phase 97 ADM-01)
# Generate a strong secret (32+ characters), e.g.:
#   openssl rand -hex 32
# Pass it as ?token=... query param OR X-Admin-Token header to access /admin/*.
# Required in production. Without it the admin gate fails closed and redirects to /.
ADMIN_TOKEN=replace-with-strong-32-plus-char-secret
